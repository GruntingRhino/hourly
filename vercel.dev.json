{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && rm -rf server/node_modules",
  "buildCommand": "npx prisma generate --schema=server/prisma/schema.prisma && cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "env": {
    "APP_ENV": "development",
    "VITE_APP_ENV": "development"
  }
}
