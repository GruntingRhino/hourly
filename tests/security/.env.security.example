# Environment for GoodHours security API tests
# Copy to .env.security and fill in values, then:
#   source .env.security && npx playwright test --config=playwright-security.config.ts

# URL of the running API server (no trailing slash)
# Default: http://localhost:3001 (direct to Express, not through Vite proxy)
API_BASE_URL=http://localhost:3001

# Set this if you want to run against staging/preview
# API_BASE_URL=https://your-preview.vercel.app
