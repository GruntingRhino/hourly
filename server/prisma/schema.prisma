generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

generator serverClient {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntegrationProvider {
  CANVAS
  GOOGLE_CLASSROOM
}

enum IntegrationConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum IntegrationSyncMode {
  PREVIEW
  APPLY
}

enum IntegrationSyncJobStatus {
  RUNNING
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum IntegrationExternalObjectType {
  COURSE
  SECTION
  USER
  ENROLLMENT
}

enum LaunchBugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LaunchBugStatus {
  OPEN
  INVESTIGATING
  BLOCKED
  FIXED
  MONITORING
  CLOSED
}

// ─── Users & Identity ───────────────────────────────────────────

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String? // nullable — Google-OAuth users may not have a password initially
  name                     String
  phone                    String?
  role                     String // SCHOOL_ADMIN, TEACHER, STUDENT, BENEFICIARY_ADMIN
  status                   String    @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  tokenVersion             Int       @default(0) // bumped on password change/reset to revoke outstanding JWTs
  googleId                 String?   @unique
  isTestAccount            Boolean   @default(false) // true = Playwright/QA account, hidden from all lists
  notificationPreferences  String? // JSON blob for notification prefs
  messagePreferences       String? // JSON blob for message/privacy prefs
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Student-specific
  grade    String?
  house    String? // optional house affiliation (configurable per school)
  cohortId String?
  cohort   Cohort? @relation("CohortStudents", fields: [cohortId], references: [id])

  // Legacy classroom (kept for migration, no longer used for new students)
  classroomId String?
  classroom   Classroom? @relation("ClassroomStudents", fields: [classroomId], references: [id])

  // Staff school association (SCHOOL_ADMIN, TEACHER)
  schoolId String?
  school   School? @relation("SchoolStaff", fields: [schoolId], references: [id])

  // Beneficiary association (BENEFICIARY_ADMIN)
  beneficiaryId        String?
  beneficiary          Beneficiary? @relation("BeneficiaryMembers", fields: [beneficiaryId], references: [id])
  beneficiaryAdminRole String? // OWNER | ADMIN; only applies to BENEFICIARY_ADMIN

  // Legacy org (kept for backward compat during migration)
  organizationId String?
  organization   Organization? @relation("OrgMembers", fields: [organizationId], references: [id])

  // Relations
  signups                              Signup[]
  serviceSessions                      ServiceSession[]
  sentMessages                         Message[]                     @relation("SentMessages")
  receivedMessages                     Message[]                     @relation("ReceivedMessages")
  interventionCampaigns                InterventionCampaign[]        @relation("InterventionActor")
  interventionRecipients               InterventionRecipient[]       @relation("InterventionStudent")
  interventionOwnedCases               InterventionCase[]            @relation("InterventionOwner")
  interventionStudentCases             InterventionCase[]            @relation("InterventionStudentCase")
  notifications                        Notification[]
  auditLogs                            AuditLog[]                    @relation("AuditActor")
  dataAccessLogs                       DataAccessLog[]               @relation("DataAccessActor")
  savedOpportunities                   SavedOpportunity[]
  createdSchools                       School[]                      @relation("SchoolCreator")
  taughtClassrooms                     Classroom[]                   @relation("ClassroomTeacher")
  selfSubmissions                      SelfSubmittedRequest[]
  assignedCohorts                      CohortTeacherAssignment[]
  cohortMemberships                    StudentCohortMembership[]
  integrationConnectionsCreated        IntegrationConnection[]       @relation("IntegrationConnectionCreator")
  integrationConnectionsUpdated        IntegrationConnection[]       @relation("IntegrationConnectionUpdater")
  integrationSyncJobsStarted           IntegrationSyncJob[]          @relation("IntegrationSyncJobStarter")
  ownedOrganizationInvoiceRequests     OrganizationInvoiceRequest[]  @relation("OrganizationInvoiceRequestOwner")
  organizationInvoiceAuditLogs         OrganizationInvoiceAuditLog[] @relation("OrganizationInvoiceAuditActor")
  uploadedOrganizationInvoiceArtifacts OrganizationInvoiceArtifact[] @relation("OrganizationInvoiceArtifactUploader")

  // Foreign-key columns filtered on constantly for tenant/relationship scoping
  // (school-scoped student/staff lookups, cohort membership, etc.) had no
  // index — every such query was a sequential scan on User.
  @@index([schoolId])
  @@index([cohortId])
  @@index([classroomId])
  @@index([beneficiaryId])
  @@index([organizationId])
}

model SchoolRegistrationIntent {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  googleId   String
  email      String
  name       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt, consumedAt])
}

// ─── Schools ────────────────────────────────────────────────────

model School {
  id                            String           @id @default(cuid())
  name                          String
  // Directory reference — if this school came from the schools directory
  directoryId                   String? // references SchoolDirectory.id
  directoryEntry                SchoolDirectory? @relation(fields: [directoryId], references: [id])
  type                          String? // public, private, charter
  address                       String?
  city                          String?
  state                         String?
  zip                           String?
  latitude                      Float?
  longitude                     Float?
  domain                        String? // official email domain(s) — eligibility check only, not self-enrollment
  verified                      Boolean          @default(false)
  ownershipStatus               String           @default("PENDING") // PENDING, APPROVED, REJECTED
  ownershipEvidenceVerifiedAt   DateTime?
  ownershipReviewedAt           DateTime?
  ownershipReviewedById         String?
  ownershipReviewNote           String?
  // Magic link registration
  registrationToken             String?          @unique
  registrationTokenExpires      DateTime?
  registrationEmail             String? // email to which the magic link was sent
  createdById                   String?
  createdBy                     User?            @relation("SchoolCreator", fields: [createdById], references: [id])
  ownershipTransferToken        String?          @unique
  ownershipTransferExpires      DateTime?
  ownershipTransferTargetUserId String?
  requiredHours                 Float            @default(40)
  verificationStandard          String           @default("STANDARD")
  serviceStartDate              DateTime?
  serviceEndDate                DateTime?
  allowSelfSubmission           Boolean          @default(true)
  ferpaBeneficiaryPiiEnabled    Boolean          @default(false) // when true, student names are shared with beneficiary admins
  requireOrgVerification        Boolean          @default(false)
  categoryHourCaps              String? // JSON: { [category: string]: number }
  // Legacy
  allowJoinByCode               Boolean          @default(false)
  onboardingComplete            Boolean          @default(false)
  partnerInviteTemplate         String?
  launchOnboardingConfig        String?
  launchSupportConfig           String?
  launchRollbackConfig          String?
  launchMonitoringConfig        String?
  zipCodes                      String? // JSON array of zip codes (service area)
  // Billing / procurement
  billingStatus                 String           @default("NONE")
  accessStatus                  String           @default("PROCUREMENT")
  pilotExpiresAt                DateTime?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  staff                   User[]                       @relation("SchoolStaff")
  cohorts                 Cohort[]
  classrooms              Classroom[] // legacy
  approvedOrgs            SchoolOrganization[] // legacy
  beneficiaryApprovals    SchoolBeneficiaryApproval[]
  groups                  StudentGroup[]
  verifiedDomains         VerifiedDomain[]
  selfSubmissions         SelfSubmittedRequest[]
  beneficiarySignups      BeneficiarySignup[]
  serviceSessions         ServiceSession[]
  launchBugs              SchoolLaunchBug[]
  integrationConnections  IntegrationConnection[]
  integrationSyncJobs     IntegrationSyncJob[]
  integrationSyncErrors   IntegrationSyncError[]
  integrationMappings     IntegrationExternalMapping[]
  interventionCampaigns   InterventionCampaign[]
  interventionCases       InterventionCase[]
  billingRecord           SchoolBillingRecord?
  quoteRequests           SchoolQuoteRequest[]
  partnerRequestsSent     SchoolPartnerRequest[]       @relation("PartnerRequestFrom")
  partnerRequestsReceived SchoolPartnerRequest[]       @relation("PartnerRequestTo")
}

enum SchoolPartnerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SchoolPartnerRequest {
  id           String                     @id @default(cuid())
  fromSchoolId String
  toSchoolId   String
  fromSchool   School                     @relation("PartnerRequestFrom", fields: [fromSchoolId], references: [id])
  toSchool     School                     @relation("PartnerRequestTo", fields: [toSchoolId], references: [id])
  status       SchoolPartnerRequestStatus @default(PENDING)
  message      String?
  respondedAt  DateTime?
  createdAt    DateTime                   @default(now())

  @@unique([fromSchoolId, toSchoolId])
}

// ─── School Directory (imported from CSV data) ───────────────────

model SchoolDirectory {
  id                String   @id @default(cuid())
  name              String
  type              String? // public, private, charter
  address           String?
  city              String?
  state             String?
  zip               String?
  latitude          Float?
  longitude         Float?
  emailDomain       String? // known official email domain if any
  claimed           Boolean  @default(false)
  claimedBySchoolId String?
  ncessId           String?  @unique // NCES school ID
  gradeRange        String? // "PK-12", "9-12", etc.
  enrollment        Int?
  phone             String?
  county            String?
  website           String? // official school website
  source            String? // "NCES_CCD", "NCES_PSS"
  updatedAt         DateTime @default(now()) @updatedAt

  schools School[]
}

// ─── Verified Domains (per school) ──────────────────────────────

model VerifiedDomain {
  id        String   @id @default(cuid())
  schoolId  String
  domain    String // e.g. "lincoln.edu"
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())

  @@unique([schoolId, domain])
}

// ─── Cohorts (replaces Classroom for new arch) ──────────────────

model Cohort {
  id                  String    @id @default(cuid())
  name                String // e.g. "Class of 2028"
  schoolId            String
  school              School    @relation(fields: [schoolId], references: [id])
  requiredHours       Float? // override school default if set
  serviceStartDate    DateTime?
  serviceEndDate      DateTime?
  allowSelfSubmission Boolean? // null = inherit from school
  categoryHourCaps    String? // JSON override; null = inherit from school
  usesHouseField      Boolean   @default(false)
  graduationYear      Int?
  status              String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  students           User[]                    @relation("CohortStudents")
  memberships        StudentCohortMembership[]
  invitations        StudentInvitation[]
  teacherAssignments CohortTeacherAssignment[]

  @@index([schoolId])
}

model StudentCohortMembership {
  id        String   @id @default(cuid())
  studentId String
  cohortId  String
  source    String   @default("MANUAL") // MANUAL, INVITATION, CANVAS
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User   @relation(fields: [studentId], references: [id])
  cohort  Cohort @relation(fields: [cohortId], references: [id])

  @@unique([studentId, cohortId])
  @@index([cohortId, isActive])
  @@index([studentId, isActive])
}

model CohortTeacherAssignment {
  id        String   @id @default(cuid())
  cohortId  String
  teacherId String
  createdAt DateTime @default(now())

  cohort  Cohort @relation(fields: [cohortId], references: [id])
  teacher User   @relation(fields: [teacherId], references: [id])

  @@unique([cohortId, teacherId])
}

// ─── Student Invitations ─────────────────────────────────────────

model StudentInvitation {
  id            String    @id @default(cuid())
  cohortId      String
  cohort        Cohort    @relation(fields: [cohortId], references: [id])
  email         String
  name          String?
  grade         String?
  house         String?
  startingHours Float? // pre-existing hours to credit as approved on join
  token         String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  status        String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  createdAt     DateTime  @default(now())

  @@unique([cohortId, email])
}

model IntegrationConnection {
  id                   String                      @id @default(cuid())
  provider             IntegrationProvider
  schoolId             String
  school               School                      @relation(fields: [schoolId], references: [id])
  status               IntegrationConnectionStatus @default(CONNECTED)
  displayName          String?
  baseUrl              String?
  credentialsEncrypted String?
  config               String?
  lastSyncedAt         DateTime?
  lastSyncStatus       IntegrationSyncJobStatus?
  lastSyncJobId        String?
  createdById          String
  createdBy            User                        @relation("IntegrationConnectionCreator", fields: [createdById], references: [id])
  updatedById          String?
  updatedBy            User?                       @relation("IntegrationConnectionUpdater", fields: [updatedById], references: [id])
  connectedAt          DateTime                    @default(now())
  disconnectedAt       DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  mappings   IntegrationExternalMapping[]
  syncJobs   IntegrationSyncJob[]
  syncErrors IntegrationSyncError[]

  @@unique([provider, schoolId])
  @@index([schoolId, provider])
}

model IntegrationExternalMapping {
  id               String                        @id @default(cuid())
  connectionId     String
  connection       IntegrationConnection         @relation(fields: [connectionId], references: [id])
  provider         IntegrationProvider
  schoolId         String
  school           School                        @relation(fields: [schoolId], references: [id])
  externalType     IntegrationExternalObjectType
  externalId       String
  externalParentId String?
  externalName     String?
  localType        String
  localId          String
  isActive         Boolean                       @default(true)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@unique([connectionId, externalType, externalId])
  @@index([schoolId, provider, localType, localId])
}

model IntegrationSyncJob {
  id           String                   @id @default(cuid())
  connectionId String
  connection   IntegrationConnection    @relation(fields: [connectionId], references: [id])
  provider     IntegrationProvider
  schoolId     String
  school       School                   @relation(fields: [schoolId], references: [id])
  mode         IntegrationSyncMode
  status       IntegrationSyncJobStatus @default(RUNNING)
  startedById  String
  startedBy    User                     @relation("IntegrationSyncJobStarter", fields: [startedById], references: [id])
  summary      String?
  startedAt    DateTime                 @default(now())
  finishedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  errors IntegrationSyncError[]

  @@index([connectionId, createdAt])
  @@index([schoolId, provider, createdAt])
}

model IntegrationSyncError {
  id           String                         @id @default(cuid())
  syncJobId    String
  syncJob      IntegrationSyncJob             @relation(fields: [syncJobId], references: [id])
  connectionId String
  connection   IntegrationConnection          @relation(fields: [connectionId], references: [id])
  provider     IntegrationProvider
  schoolId     String
  school       School                         @relation(fields: [schoolId], references: [id])
  externalType IntegrationExternalObjectType?
  externalId   String?
  localType    String?
  localId      String?
  code         String
  message      String
  details      String?
  createdAt    DateTime                       @default(now())

  @@index([syncJobId, createdAt])
  @@index([schoolId, provider, createdAt])
}

// ─── Beneficiaries ──────────────────────────────────────────────

model Beneficiary {
  id                String                @id @default(cuid())
  name              String
  email             String?
  phone             String?
  description       String?
  website           String?
  category          String? // environment, education, food, etc.
  address           String?
  city              String?
  state             String?
  zip               String?
  latitude          Float?
  longitude         Float?
  // Directory status
  directoryId       String? // references BeneficiaryDirectory.id
  directoryEntry    BeneficiaryDirectory? @relation(fields: [directoryId], references: [id])
  status            String                @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  visibility        String                @default("PRIVATE") // PUBLIC, PRIVATE (school-created)
  claimed           Boolean               @default(false)
  createdBySchoolId String? // if school-created custom beneficiary
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  planTier                  String    @default("FREE") // FREE, PRO
  hasSchoolComplimentaryPro Boolean   @default(false)
  proActivatedAt            DateTime?
  timezone                  String    @default("America/New_York") // IANA timezone for event times
  uploadAbuseStrikes        Int       @default(0)
  uploadSuspendedUntil      DateTime?

  // Custom email branding (Pro)
  brandColor     String?
  logoUrl        String?
  emailSignature String?

  // Stripe subscription fields
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  stripeEventCreatedAt DateTime?
  subscriptionStatus   String    @default("FREE")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  billingInterval      String? // "monthly" | "annual"

  members               User[]                             @relation("BeneficiaryMembers")
  opportunities         BeneficiaryOpportunity[]
  schoolApprovals       SchoolBeneficiaryApproval[]
  invitations           BeneficiaryInvitation[]
  adminInvitations      BeneficiaryAdminInvitation[]
  attachments           BeneficiaryOpportunityAttachment[]
  reminderConfig        OrgReminderConfig?
  invoiceRequests       OrganizationInvoiceRequest[]
  stripeCheckoutAttempt StripeCheckoutAttempt?
}

model StripeCheckoutAttempt {
  id              String   @id @default(cuid())
  beneficiaryId   String   @unique
  interval        String
  idempotencyKey  String   @unique
  stripeSessionId String?  @unique
  checkoutUrl     String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

// ─── Beneficiary Directory (IRS 501c3 + public institutions) ────

model BeneficiaryDirectory {
  id        String   @id @default(cuid())
  name      String
  ein       String?  @unique // EIN for 501c3s
  category  String?
  address   String?
  city      String?
  state     String?
  zip       String?
  latitude  Float?
  longitude Float?
  email     String?
  website   String?
  claimed   Boolean  @default(false)
  nteeCode  String? // NTEE classification code (IRS)
  ncessId   String?  @unique // NCES school ID (for schools imported from NCES data)
  phone     String?
  source    String? // "IRS", "NCES", "IMLS", "MANUAL"
  county    String?
  active    Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt

  beneficiaries Beneficiary[]
}

// ─── School <-> Beneficiary Approval ────────────────────────────

enum SchoolBeneficiaryApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

model SchoolBeneficiaryApproval {
  id            String                          @id @default(cuid())
  schoolId      String
  beneficiaryId String
  status        SchoolBeneficiaryApprovalStatus @default(PENDING)
  approvedAt    DateTime?
  school        School                          @relation(fields: [schoolId], references: [id])
  beneficiary   Beneficiary                     @relation(fields: [beneficiaryId], references: [id])
  createdAt     DateTime                        @default(now())

  @@unique([schoolId, beneficiaryId])
}

// ─── Beneficiary Invitations ─────────────────────────────────────

enum BeneficiaryInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model BeneficiaryInvitation {
  id            String                      @id @default(cuid())
  schoolId      String // which school is inviting
  beneficiaryId String
  beneficiary   Beneficiary                 @relation(fields: [beneficiaryId], references: [id])
  token         String                      @unique
  expiresAt     DateTime
  status        BeneficiaryInvitationStatus @default(PENDING)
  sentTo        String // email address sent to
  acceptedAt    DateTime?
  respondedAt   DateTime?
  createdAt     DateTime                    @default(now())
}

enum BeneficiaryAdminInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model BeneficiaryAdminInvitation {
  id            String                           @id @default(cuid())
  beneficiaryId String
  beneficiary   Beneficiary                      @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  email         String
  token         String                           @unique
  expiresAt     DateTime
  status        BeneficiaryAdminInvitationStatus @default(PENDING)
  invitedById   String
  acceptedAt    DateTime?
  createdAt     DateTime                         @default(now())

  @@index([beneficiaryId, status])
  @@index([email, status])
}

// ─── Self-Submitted Volunteering Requests ───────────────────────

model SelfSubmittedRequest {
  id                 String    @id @default(cuid())
  studentId          String
  student            User      @relation(fields: [studentId], references: [id])
  schoolId           String
  school             School    @relation(fields: [schoolId], references: [id])
  organizationName   String // name of place they volunteered at
  description        String
  date               DateTime
  hours              Float
  evidenceNote       String? // optional description/link
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, REVISION_REQUESTED
  reviewedBy         String?
  reviewedAt         DateTime?
  rejectionReason    String?
  revisionNote       String? // admin note when requesting revision
  timesRevised       Int       @default(0)
  convertedSessionId String? // if approved → creates a ServiceSession
  category           String? // e.g. "environment", "education", "food", "health", "general"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([studentId, status])
  @@index([schoolId, status])
}

// ─── Beneficiary Opportunities ───────────────────────────────────

model BeneficiaryOpportunity {
  id                 String      @id @default(cuid())
  title              String
  description        String
  beneficiaryId      String
  beneficiary        Beneficiary @relation(fields: [beneficiaryId], references: [id])
  category           String?
  location           String?
  address            String?
  latitude           Float?
  longitude          Float?
  startDate          DateTime
  endDate            DateTime?
  status             String      @default("ACTIVE") // ACTIVE, CANCELLED, COMPLETED
  requirementsNote   String?
  customFields       String? // JSON
  schoolRestrictions String? // JSON array of school IDs (null = all approved schools)
  recurrenceRule     String? // JSON: { type, dayOfWeek?, weeksOfMonth?, datesOfMonth?, startTime, endTime, capacity }

  // Event content fields (visible in reminder emails)
  preparationNotes    String? // what volunteers should bring / prepare
  arrivalInstructions String? // parking, entrance, check-in details
  contactInfo         String? // on-site contact name + number

  // Required-form / waiver (Free: attachment visible; Pro: automated follow-up reminders)
  requiredFormUrl        String?
  requiredFormName       String?
  requiredFormIsRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeSlots   BeneficiaryTimeSlot[]
  attachments BeneficiaryOpportunityAttachment[]

  @@index([beneficiaryId])
}

// ─── Beneficiary Opportunity Attachments ──────────────────────────

model BeneficiaryOpportunityAttachment {
  id            String                 @id @default(cuid())
  opportunityId String
  opportunity   BeneficiaryOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  beneficiaryId String
  beneficiary   Beneficiary            @relation(fields: [beneficiaryId], references: [id])
  filename      String // stored filename on disk (UUID-based); multiple records may share a filename via dedup
  originalName  String // original filename from uploader
  mimeType      String // verified from magic bytes, not client-supplied header
  size          Int // bytes, verified from fs.stat after upload
  sha256        String // SHA-256 hex digest for deduplication
  contentBytes  Bytes? // durable DB-backed storage for serverless deployments
  createdAt     DateTime               @default(now())
}

// ─── Beneficiary Time Slots ───────────────────────────────────────

model BeneficiaryTimeSlot {
  id               String                 @id @default(cuid())
  opportunityId    String
  opportunity      BeneficiaryOpportunity @relation(fields: [opportunityId], references: [id])
  date             DateTime
  startTime        String // "10:00 AM"
  endTime          String // "2:00 PM"
  durationHours    Float
  capacity         Int                    @default(10)
  recurringGroupId String? // links all slots in the same recurrence series
  createdAt        DateTime               @default(now())

  signups BeneficiarySignup[]

  @@index([date])
  @@index([opportunityId])
}

// ─── Beneficiary Signups (new model) ────────────────────────────

model BeneficiarySignup {
  id                 String              @id @default(cuid())
  slotId             String
  slot               BeneficiaryTimeSlot @relation(fields: [slotId], references: [id])
  studentId          String
  schoolId           String?
  school             School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  status             String              @default("CONFIRMED") // CONFIRMED, WAITLISTED, CANCELLED, NO_SHOW
  checkedIn          Boolean             @default(false)
  checkedInAt        DateTime?
  checkedOut         Boolean             @default(false)
  checkedOutAt       DateTime?
  totalHours         Float?
  verificationStatus String              @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  // One-click cancellation (token emailed to volunteer; single-use)
  cancellationToken  String?             @unique

  // Attendance outcome (recorded after the event by the org)
  attendance String? // ATTENDED | NO_SHOW | null (not yet recorded)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs    BeneficiaryAuditLog[]
  reminderLogs OrgEventReminderLog[]

  @@unique([slotId, studentId])
  @@index([schoolId, studentId])
  @@index([studentId, verificationStatus, status])
  @@index([slotId, status])
  @@index([status, verificationStatus])
}

// ─── Beneficiary Audit Log ────────────────────────────────────────

model BeneficiaryAuditLog {
  id        String             @id @default(cuid())
  action    String // APPROVE, REJECT, OVERRIDE, CHECK_IN, CHECK_OUT
  details   String? // JSON
  actorId   String
  signupId  String?
  signup    BeneficiarySignup? @relation(fields: [signupId], references: [id])
  createdAt DateTime           @default(now())
}

// ─── Org Reminder Configuration (Pro) ───────────────────────────

model OrgReminderConfig {
  id            String      @id @default(cuid())
  beneficiaryId String      @unique
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  // JSON array of {minutesBefore:number, enabled:boolean, label:string}
  // Free default: [{minutesBefore:1440, enabled:true, label:"24 hours before"}]
  // Pro default adds 48h+3h entries
  reminders String @default("[{\"minutesBefore\":1440,\"enabled\":true,\"label\":\"24 hours before\"}]")

  // Pro-only waitlist controls
  waitlistCutoffHours         Int? // stop promoting waitlist this many hours before event
  requireApprovalForPromotion Boolean @default(false)
  disableAutoPromotion        Boolean @default(false)
  promoMessageTemplate        String? // custom message sent to promoted volunteer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Event Reminder Log (idempotency) ───────────────────────────

enum OrgEventReminderDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model OrgEventReminderLog {
  id                String                         @id @default(cuid())
  signupId          String
  signup            BeneficiarySignup              @relation(fields: [signupId], references: [id], onDelete: Cascade)
  beneficiaryId     String
  opportunityId     String
  reminderType      String // FREE_24H | PRO_CUSTOM_{minutesBefore}
  scheduledFor      DateTime
  sentAt            DateTime?
  deliveryStatus    OrgEventReminderDeliveryStatus @default(PENDING)
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime                       @default(now())

  @@unique([signupId, reminderType])
  @@index([beneficiaryId, deliveryStatus])
  @@index([scheduledFor, deliveryStatus])
}

// ─── Legacy: Classrooms ─────────────────────────────────────────
// Kept for backward compat — new schools use Cohorts instead

model Classroom {
  id         String   @id @default(cuid())
  name       String
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  teacherId  String
  teacher    User     @relation("ClassroomTeacher", fields: [teacherId], references: [id])
  inviteCode String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students User[] @relation("ClassroomStudents")
}

// ─── Legacy: Organizations ──────────────────────────────────────
// Kept for backward compat — new entities use Beneficiary model

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  email       String
  phone       String?
  description String?
  website     String?
  avatarUrl   String?
  status      OrganizationStatus @default(PENDING)
  zipCodes    String? // JSON array of zip codes
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  members         User[]               @relation("OrgMembers")
  opportunities   Opportunity[]
  schoolApprovals SchoolOrganization[]
}

// ─── Legacy: School <-> Organization approval ───────────────────

enum SchoolOrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

model SchoolOrganization {
  id             String                   @id @default(cuid())
  schoolId       String
  organizationId String
  status         SchoolOrganizationStatus @default(PENDING)
  approvedAt     DateTime?
  school         School                   @relation(fields: [schoolId], references: [id])
  organization   Organization             @relation(fields: [organizationId], references: [id])
  createdAt      DateTime                 @default(now())

  @@unique([schoolId, organizationId])
}

// ─── Student Groups (for school admin) ──────────────────────────

model StudentGroup {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())

  members StudentGroupMember[]
}

model StudentGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  studentId String
  group     StudentGroup @relation(fields: [groupId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([groupId, studentId])
}

model SchoolLaunchBug {
  id          String            @id @default(cuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id])
  title       String
  description String?
  severity    LaunchBugSeverity @default(MEDIUM)
  status      LaunchBugStatus   @default(OPEN)
  area        String?
  source      String?
  ownerName   String?
  workaround  String?
  nextAction  String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, severity])
}

// ─── Legacy: Opportunities ──────────────────────────────────────

enum OpportunityStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

model Opportunity {
  id               String            @id @default(cuid())
  title            String
  description      String
  tags             String? // JSON array string
  location         String
  address          String?
  latitude         Float?
  longitude        Float?
  date             DateTime
  startTime        String // "10:00 AM"
  endTime          String // "2:00 PM"
  durationHours    Float
  capacity         Int
  ageRequirement   Int?
  gradeRequirement String?
  isRecurring      Boolean           @default(false)
  recurringPattern String? // JSON
  customFields     String? // JSON: [{label:string, value:string}]
  status           OpportunityStatus @default(ACTIVE)
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  signups         Signup[]
  serviceSessions ServiceSession[]
  savedBy         SavedOpportunity[]
}

// ─── Legacy: Signups ────────────────────────────────────────────

enum SignupStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  NO_SHOW
}

model Signup {
  id            String       @id @default(cuid())
  userId        String
  opportunityId String
  status        SignupStatus @default(CONFIRMED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([userId, opportunityId])
}

// ─── Saved/Bookmarked Opportunities ─────────────────────────────

enum SavedOpportunityStatus {
  SAVED
  SKIPPED
  DISCARDED
}

model SavedOpportunity {
  id            String                 @id @default(cuid())
  userId        String
  opportunityId String
  status        SavedOpportunityStatus @default(SAVED)
  createdAt     DateTime               @default(now())

  user        User        @relation(fields: [userId], references: [id])
  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([userId, opportunityId])
}

// ─── Service Sessions (attendance records) ──────────────────────

model ServiceSession {
  id                 String    @id @default(cuid())
  userId             String
  schoolId           String?
  opportunityId      String
  checkInTime        DateTime?
  checkOutTime       DateTime?
  totalHours         Float?
  status             String    @default("COMMITTED") // COMMITTED, PENDING_VERIFICATION, VERIFIED, REJECTED, PENDING_CHECKIN, CHECKED_IN, CHECKED_OUT
  verificationStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?

  // Verification submission fields
  signatureType         String? // "DRAWN" or "FILE"
  signatureData         String? // Base64 eSignature data (for DRAWN type)
  signatureFileName     String? // Original filename
  signatureFileBytes    Bytes? // Durable file-signature evidence; never a temporary filesystem path
  signatureFileMimeType String?
  submittedAt           DateTime? // When verification was submitted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  school      School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  auditLogs   AuditLog[]

  @@unique([userId, opportunityId])
  @@index([userId, verificationStatus])
  @@index([schoolId, userId, verificationStatus])
  @@index([status, verificationStatus])
}

// ─── Audit Log (immutable) ──────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String // CHECK_IN, CHECK_OUT, APPROVE, REJECT, OVERRIDE, etc.
  details   String? // JSON
  actorId   String
  sessionId String?
  createdAt DateTime @default(now())

  actor   User            @relation("AuditActor", fields: [actorId], references: [id])
  session ServiceSession? @relation(fields: [sessionId], references: [id])

  @@index([action, createdAt])
  @@index([sessionId, createdAt])
}

// ─── Data Access Log (FERPA compliance — read-access trail) ─────

model DataAccessLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("DataAccessActor", fields: [actorId], references: [id])
  action     String // VIEW_STUDENT_REPORT, VIEW_SCHOOL_REPORT, EXPORT_CSV, VIEW_SESSIONS, VIEW_STUDENT_LIST, EXPORT_SCHOOL_DATA, DELETE_STUDENT
  targetType String? // "student", "school", "session"
  targetId   String? // ID of the accessed record
  schoolId   String? // school context of the access
  details    String? // JSON
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
}

// ─── Messages ───────────────────────────────────────────────────

model Message {
  id         String   @id @default(cuid())
  subject    String?
  body       String
  senderId   String
  receiverId String
  priority   Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender                User                   @relation("SentMessages", fields: [senderId], references: [id])
  receiver              User                   @relation("ReceivedMessages", fields: [receiverId], references: [id])
  interventionRecipient InterventionRecipient?

  @@index([receiverId, createdAt])
  @@index([senderId, createdAt])
}

model InterventionCampaign {
  id             String   @id @default(cuid())
  schoolId       String
  actorId        String
  actionType     String
  audienceType   String
  queueType      String?
  savedView      String?
  subject        String?
  bodyPreview    String?
  priority       Boolean  @default(false)
  recipientCount Int      @default(0)
  metadata       String?
  createdAt      DateTime @default(now())

  school     School                  @relation(fields: [schoolId], references: [id])
  actor      User                    @relation("InterventionActor", fields: [actorId], references: [id])
  recipients InterventionRecipient[]

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
}

model InterventionRecipient {
  id         String   @id @default(cuid())
  campaignId String
  studentId  String
  messageId  String?  @unique
  createdAt  DateTime @default(now())

  campaign InterventionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  student  User                 @relation("InterventionStudent", fields: [studentId], references: [id])
  message  Message?             @relation(fields: [messageId], references: [id])

  @@unique([campaignId, studentId])
  @@index([studentId, createdAt])
}

enum InterventionCaseStatus {
  OPEN
  WAITING_ON_STUDENT
  WAITING_ON_SCHOOL
  MONITORING
  RESOLVED
}

model InterventionCase {
  id                  String                 @id @default(cuid())
  schoolId            String
  studentId           String
  ownerId             String?
  status              InterventionCaseStatus @default(OPEN)
  priority            String                 @default("MEDIUM")
  reason              String?
  summary             String?
  nextStepForStudent  String?
  nextStepForStaff    String?
  staffNote           String?
  studentMessage      String?
  dueDate             DateTime?
  lastContactedAt     DateTime?
  lastStudentActionAt DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  school  School @relation(fields: [schoolId], references: [id])
  student User   @relation("InterventionStudentCase", fields: [studentId], references: [id])
  owner   User?  @relation("InterventionOwner", fields: [ownerId], references: [id])

  @@unique([schoolId, studentId])
  @@index([schoolId, status, priority])
  @@index([studentId, updatedAt])
}

// ─── Notifications ──────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // SIGNUP_CONFIRMED, EVENT_REMINDER, VERIFICATION_UPDATE, INVITATION, etc.
  title     String
  body      String
  read      Boolean  @default(false)
  data      String? // JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, read, createdAt])
  @@index([userId, type, createdAt])
}

// ─── Organization Billing ─────────────────────────────────────────────────

enum OrganizationInvoiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  INVOICE_SENT
  PAID
  REJECTED
  CANCELLED
}

model OrganizationInvoiceRequest {
  id                       String                           @id @default(cuid())
  beneficiaryId            String
  beneficiary              Beneficiary                      @relation(fields: [beneficiaryId], references: [id])
  status                   OrganizationInvoiceRequestStatus @default(SUBMITTED)
  ownerUserId              String?
  ownerUser                User?                            @relation("OrganizationInvoiceRequestOwner", fields: [ownerUserId], references: [id])
  legalName                String
  address                  String
  billingContactName       String
  billingContactEmail      String
  purchaseOrderRequired    Boolean                          @default(false)
  taxExempt                Boolean                          @default(false)
  requestedBillingInterval String? // "monthly" or "annual" for procurement quotes
  preferredPaymentMethod   String?
  additionalNotes          String?
  internalNotes            String?
  quoteAmountCents         Int?
  quoteSentAt              DateTime?
  invoiceNumber            String?
  invoiceSentAt            DateTime?
  paidAt                   DateTime?
  rejectedReason           String?
  lastContactedAt          DateTime?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  auditLogs                OrganizationInvoiceAuditLog[]
  artifacts                OrganizationInvoiceArtifact[]

  @@index([ownerUserId])
}

model OrganizationInvoiceAuditLog {
  id                String                     @id @default(cuid())
  invoiceRequestId  String
  invoiceRequest    OrganizationInvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Cascade)
  previousStatus    String?
  newStatus         String
  changedByUserId   String
  changedByUser     User                       @relation("OrganizationInvoiceAuditActor", fields: [changedByUserId], references: [id])
  entryType         String                     @default("STATUS")
  visibleToCustomer Boolean                    @default(false)
  subject           String?
  note              String?
  changedAt         DateTime                   @default(now())

  @@index([invoiceRequestId, changedAt])
}

model OrganizationInvoiceArtifact {
  id               String                     @id @default(cuid())
  invoiceRequestId String
  invoiceRequest   OrganizationInvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Cascade)
  documentType     String
  filename         String
  originalName     String
  storedPath       String
  fileSizeBytes    Int
  mimeType         String
  contentBytes     Bytes?
  uploadedByUserId String
  uploadedByUser   User                       @relation("OrganizationInvoiceArtifactUploader", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime                   @default(now())

  @@index([invoiceRequestId, createdAt])
}

// ─── School Procurement ───────────────────────────────────────────────────

model SchoolBillingRecord {
  id                   String                      @id @default(cuid())
  schoolId             String                      @unique
  school               School                      @relation(fields: [schoolId], references: [id])
  billingStatus        String                      @default("QUOTE_REQUESTED")
  pricePerStudentCents Int?
  annualMinimumCents   Int?
  enrollmentCount      Int?
  verifiedEnrollment   Int?
  contractAmountCents  Int?
  contractStartDate    DateTime?
  contractEndDate      DateTime?
  billingContactName   String?
  billingContactEmail  String?
  billingContactPhone  String?
  goodhoursContactId   String?
  purchaseOrderNumber  String?
  invoiceNumber        String?
  paymentStatus        String?
  internalNotes        String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  auditLogs            SchoolBillingAuditLog[]
  documents            SchoolProcurementDocument[]
}

model SchoolQuoteRequest {
  id                             String    @id @default(cuid())
  schoolId                       String
  school                         School    @relation(fields: [schoolId], references: [id])
  schoolName                     String
  districtName                   String?
  schoolWebsite                  String?
  schoolAddress                  String?
  schoolState                    String?
  enrollment                     Int
  gradeLevels                    String?
  primaryContactName             String
  primaryContactTitle            String?
  primaryContactEmail            String
  primaryContactPhone            String?
  billingContactName             String?
  billingContactEmail            String?
  billingContactPhone            String?
  billingAddress                 String?
  purchaseOrderRequired          Boolean   @default(false)
  vendorRegistrationRequired     Boolean   @default(false)
  w9Required                     Boolean   @default(false)
  certificateOfInsuranceRequired Boolean   @default(false)
  dataPrivacyAgreementRequired   Boolean   @default(false)
  preferredStartDate             DateTime?
  procurementNotes               String?
  estimatedAnnualCents           Int?
  createdAt                      DateTime  @default(now())
}

model SchoolProcurementDocument {
  id               String              @id @default(cuid())
  billingRecordId  String
  billingRecord    SchoolBillingRecord @relation(fields: [billingRecordId], references: [id])
  schoolId         String
  documentType     String
  filename         String
  originalName     String
  storedPath       String
  fileSizeBytes    Int
  mimeType         String
  contentBytes     Bytes?
  uploadedByUserId String
  createdAt        DateTime            @default(now())
}

model SchoolBillingAuditLog {
  id              String              @id @default(cuid())
  billingRecordId String
  billingRecord   SchoolBillingRecord @relation(fields: [billingRecordId], references: [id])
  schoolId        String
  previousStatus  String?
  newStatus       String
  changedByUserId String
  changedAt       DateTime            @default(now())
  note            String?
}

// Stripe webhook idempotency — prevents duplicate processing of replayed events
model StripeProcessedEvent {
  id          String   @id // Stripe event ID (e.g. "evt_...")
  processedAt DateTime @default(now())
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model ScheduledJobLease {
  jobName    String    @id
  leaseUntil DateTime
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([leaseUntil])
}
