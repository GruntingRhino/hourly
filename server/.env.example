# Production database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/prod_dbname?sslmode=require"

# Development database connection string.
# When APP_ENV=development, DEV_DATABASE_URL overrides DATABASE_URL.
DEV_DATABASE_URL="postgresql://user:password@localhost:5432/goodhours_dev"

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET="<generate with: openssl rand -hex 64>"

# Server port (default: 3001)
PORT=3001

# Frontend URL — used for CORS and redirects
APP_URL="http://localhost:5173"

# Resend email service
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@notifications.yourdomain.com

# Email delivery mode:
# - auto: send when provider config exists, otherwise log only in dev
# - send: always attempt real delivery
# - log: never send, only log/capture locally
EMAIL_DELIVERY_MODE=auto

# Client URL — used in email links (set to production URL in prod)
CLIENT_URL=https://yourdomain.com

APPROVED_SCHOOL_DOMAINS=   # Comma-separated list of approved email domains (prod only). Leave empty = no restriction.

# Set to "true" in dev/test to disable all email-domain checks (personal-domain block + school-directory domain matching).
# Never set this in production.
ALLOW_PERSONAL_EMAIL_DOMAINS=true

# Explicit app environment.
APP_ENV=development

# Keep this false in normal local work so dev cannot accidentally boot against a shared/prod Neon database.
ALLOW_SHARED_DEV_DATABASE=false
