# Production database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/prod_dbname?sslmode=require"

# Development database connection string.
# When APP_ENV=development, DEV_DATABASE_URL overrides DATABASE_URL.
DEV_DATABASE_URL="postgresql://user:password@localhost:5432/goodhours_dev"

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET="<generate with: openssl rand -hex 64>"

# Previous JWT signing secret, set only during a rotation window.
# New tokens are signed with JWT_SECRET; verification falls back to this value
# so sessions issued before the rotation stay valid until they expire (7 days).
# Clear it 7+ days after rotating. See docs/jwt-secret-rotation.md.
JWT_SECRET_PREVIOUS=

# Field-level encryption for sensitive integration credentials and PII.
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY="<generate with: openssl rand -hex 32>"

# Server port (default: 3001)
PORT=3001

# Frontend URL — used for CORS and redirects
APP_URL="http://localhost:5173"

# Resend email service
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@notifications.yourdomain.com

# Email delivery mode:
# - auto: send when provider config exists, otherwise log only in dev
# - send: always attempt real delivery
# - log: never send, only log/capture locally
EMAIL_DELIVERY_MODE=auto

# Stripe organization subscriptions — server-only values. Use test-mode values
# locally and Preview; configure separate live values for Production. Never use
# any VITE_/client variable for the secret key or webhook signing secret.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ORG_PRO_MONTHLY_PRICE_ID=price_replace_me
STRIPE_ORG_PRO_ANNUAL_PRICE_ID=price_replace_me

# School annual quote estimates. The introductory rate automatically changes to
# the standard rate at this UTC timestamp; adjust the date/value in deployment
# configuration without a code change. No annual minimum applies.
SCHOOL_PRICE_PER_STUDENT_CENTS=50
SCHOOL_STANDARD_PRICE_PER_STUDENT_CENTS=100
SCHOOL_PRICE_INCREASE_EFFECTIVE_AT=2026-10-24T00:00:00.000Z

# Client URL — used in email links (set to production URL in prod)
CLIENT_URL=https://yourdomain.com

# Allowed browser origins for the API. Leave empty in local development unless
# you need to override the built-in defaults.
ALLOWED_ORIGINS=

APPROVED_SCHOOL_DOMAINS=   # Comma-separated list of approved email domains (prod only). Leave empty = no restriction.

# Set to "true" in dev/test to disable all email-domain checks (personal-domain block + school-directory domain matching).
# Never set this in production.
ALLOW_PERSONAL_EMAIL_DOMAINS=true

# Set to "true" only for tightly scoped QA alias testing (e.g. abhay.sivaram+...@gmail.com).
# Keep false/off in production-like environments so personal Gmail signups stay blocked by default.
ALLOW_QA_SIGNUP_BYPASS=false

# Explicit app environment.
APP_ENV=development

# Durable production rate limiting: production uses Upstash when both values are
# present; otherwise it uses the shared PostgreSQL DATABASE_URL. These are server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Keep this false in normal local work so dev cannot accidentally boot against a shared/prod Neon database.
ALLOW_SHARED_DEV_DATABASE=false

# Shared secret for internal scheduled jobs and ops endpoints.
CRON_SECRET="<generate with: openssl rand -hex 32>"

# Canvas LMS integration
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_CALLBACK_URL=http://localhost:3001/api/integrations/canvas/oauth/callback
CANVAS_ENABLE_MOCK=true
CANVAS_REQUEST_TIMEOUT_MS=15000
CANVAS_PAGE_SIZE=100

# Google Classroom integration
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_CALLBACK_URL=http://localhost:3001/api/integrations/googleClassroom/oauth/callback
GOOGLE_CLASSROOM_ENABLE_MOCK=true
GOOGLE_CLASSROOM_REQUEST_TIMEOUT_MS=15000
GOOGLE_CLASSROOM_PAGE_SIZE=100
GOOGLE_CLASSROOM_API_BASE_URL=https://classroom.googleapis.com
GOOGLE_CLASSROOM_AUTH_BASE_URL=https://accounts.google.com
GOOGLE_CLASSROOM_TOKEN_BASE_URL=https://oauth2.googleapis.com
