# Safe test environment — loaded automatically by `npm test` (see pretest/test scripts).
# These are DUMMY values by design. NEVER place real credentials, staging secrets,
# or production URLs in this file. The database is a local disposable Postgres
# (created by scripts/ensure-test-db.sh); integration tests mock Prisma queries.
NODE_ENV=test
APP_ENV=development

# Local disposable Postgres (podman/docker, port 5433, container goodhours-test-pg).
# Real env always wins over this file (node --env-file precedence), so exporting
# your own DATABASE_URL (as CI does) overrides it.
DATABASE_URL=postgresql://goodhours_test:goodhours-local-test-only@127.0.0.1:5433/goodhours_test?schema=public

# Dummy auth/crypto secrets (valid format only — used solely for signing test JWTs)
JWT_SECRET=test-only-jwt-secret-not-used-in-any-real-environment
FIELD_ENCRYPTION_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
CRON_SECRET=test-only-cron-secret

# Never send real email from tests
EMAIL_DELIVERY_MODE=log

ALLOW_SHARED_DEV_DATABASE=true
