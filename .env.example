# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled recommended for Vercel)
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-here
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=your-64-hex-character-field-encryption-key

# ─── App URLs ─────────────────────────────────────────────────────────────────
APP_URL=https://goodhours.app
CLIENT_URL=https://goodhours.app
PORT=3001
ALLOWED_ORIGINS=https://goodhours.app

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
# Authorized origins: https://goodhours.app
# Authorized redirect URIs: https://goodhours.app/school/register
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional override. Must match the Google Console redirect URI exactly.
# Defaults to: ${CLIENT_URL}/school/register
GOOGLE_CALLBACK_URL=https://goodhours.app/school/register

# ─── Canvas LMS Integration ───────────────────────────────────────────────────
# OAuth callback must exactly match the Canvas developer key redirect URI.
CANVAS_CLIENT_ID=your-canvas-client-id
CANVAS_CLIENT_SECRET=your-canvas-client-secret
CANVAS_CALLBACK_URL=https://goodhours.app/api/integrations/canvas/oauth/callback
CANVAS_ENABLE_MOCK=false
CANVAS_REQUEST_TIMEOUT_MS=15000
CANVAS_PAGE_SIZE=100

# ─── Google Classroom Integration ─────────────────────────────────────────────
# OAuth callback must exactly match the Google Cloud OAuth client redirect URI.
GOOGLE_CLASSROOM_CLIENT_ID=your-classroom-client-id.apps.googleusercontent.com
GOOGLE_CLASSROOM_CLIENT_SECRET=your-classroom-client-secret
GOOGLE_CLASSROOM_CALLBACK_URL=https://goodhours.app/api/integrations/googleClassroom/oauth/callback
GOOGLE_CLASSROOM_ENABLE_MOCK=false
GOOGLE_CLASSROOM_REQUEST_TIMEOUT_MS=15000
GOOGLE_CLASSROOM_PAGE_SIZE=100
GOOGLE_CLASSROOM_API_BASE_URL=https://classroom.googleapis.com
GOOGLE_CLASSROOM_AUTH_BASE_URL=https://accounts.google.com
GOOGLE_CLASSROOM_TOKEN_BASE_URL=https://oauth2.googleapis.com

# ─── Internal Jobs / Ops ──────────────────────────────────────────────────────
CRON_SECRET=your-cron-shared-secret

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
# Verified sending domain required — e.g. notifications.goodhours.app
EMAIL_FROM=GoodHours <noreply@notifications.goodhours.app>

# ─── Stripe Organization Billing (server-only) ───────────────────────────────
# Use separate test-mode values in Development/Preview and live-mode values in
# Production. These values must never be added to client env files or bundled.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ORG_PRO_MONTHLY_PRICE_ID=price_replace_me
STRIPE_ORG_PRO_ANNUAL_PRICE_ID=price_replace_me

# ─── School Quote Pricing ────────────────────────────────────────────────────
# $0.50/student before the effective timestamp, $1/student afterward. Set the
# production timestamp during rollout; no annual minimum is applied.
SCHOOL_PRICE_PER_STUDENT_CENTS=50
SCHOOL_STANDARD_PRICE_PER_STUDENT_CENTS=100
SCHOOL_PRICE_INCREASE_EFFECTIVE_AT=2026-10-24T00:00:00.000Z
